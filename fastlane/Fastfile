default_platform(:ios)

# fastlane runs lanes with the fastlane/ directory as the working directory,
# so anchor all project paths explicitly.
ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(ROOT, "Souvera.xcodeproj")
SCHEME = "Nextcloud"
TEAM_ID = "S76D7JCS9V"
EXPORT_DIR = File.join(ROOT, "build", "export")

# The .p8 file is written by the workflow step "Install App Store Connect API key".
def souvera_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_API_KEY_ID"),
    issuer_id: ENV.fetch("ASC_API_ISSUER_ID"),
    key_filepath: ENV.fetch(
      "ASC_API_KEY_PATH",
      File.expand_path("~/private_keys/AuthKey_#{ENV.fetch('ASC_API_KEY_ID')}.p8")
    ),
    in_house: false
  )
end

platform :ios do
  desc "Set the build number to (latest TestFlight build + 1)"
  lane :bump_build_number do |options|
    souvera_api_key
    version = get_version_number(xcodeproj: PROJECT, target: SCHEME)
    current = get_build_number(xcodeproj: PROJECT).to_i
    latest = begin
      latest_testflight_build_number(version: version, initial_build_number: current)
    rescue StandardError => e
      UI.message("Could not read latest TestFlight build number: #{e.message}")
      current
    end
    next_number = [current, latest + 1].max
    increment_build_number(build_number: next_number, xcodeproj: PROJECT)
    UI.message("Set build number to #{next_number} (version #{version})")
  end

  desc "Upload an already exported IPA (build/export/*.ipa) to TestFlight"
  lane :upload_beta do |options|
    souvera_api_key
    ipa = options[:ipa] || Dir[File.join(EXPORT_DIR, "*.ipa")].first
    UI.user_error!("No IPA found in #{EXPORT_DIR} — run the archive steps first") unless ipa && File.exist?(ipa)

    pilot(
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      changelog: ENV["TESTFLIGHT_CHANGELOG"]
    )

    # App-Symbol-Metadaten automatisch mitsetzen (ASC "App-Symbol"): der
    # Ordner enthält NUR app_icon.png - deliver lädt damit ausschließlich
    # das Icon hoch und fasst keine anderen Metadaten an.
    deliver(
      metadata_path: File.join(ROOT, "fastlane", "metadata"),
      skip_screenshots: true,
      skip_binary_upload: true,
      force: true
    )
  end

  desc "Upload the IPA to App Store Connect (App Store release). Optional: submit for review via SUBMIT_FOR_REVIEW=1"
  lane :upload_appstore do |options|
    souvera_api_key
    ipa = options[:ipa] || Dir[File.join(EXPORT_DIR, "*.ipa")].first
    UI.user_error!("No IPA found in #{EXPORT_DIR} — run the archive steps first") unless ipa && File.exist?(ipa)

    pilot(
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      changelog: ENV["TESTFLIGHT_CHANGELOG"]
    )

    deliver(
      metadata_path: File.join(ROOT, "fastlane", "metadata"),
      skip_screenshots: true,
      skip_binary_upload: true,
      force: true
    )

    if ENV["SUBMIT_FOR_REVIEW"] == "1"
      deliver(
        submit_for_review: true,
        automatic_release: true,
        force: true
      )
      UI.message("Submitted the build for App Store review")
    else
      UI.message("App Store upload done - submit for review manually in App Store Connect or re-run with SUBMIT_FOR_REVIEW=1")
    end
  end

  desc "Build, sign and upload a beta build to TestFlight"
  lane :beta do |options|
    souvera_api_key
    export_method = options[:export_method] || "app-store-connect"

    version = get_version_number(xcodeproj: PROJECT, target: SCHEME)
    current = get_build_number(xcodeproj: PROJECT).to_i
    latest = begin
      latest_testflight_build_number(version: version, initial_build_number: 0)
    rescue StandardError => e
      UI.message("Could not read latest TestFlight build number: #{e.message}")
      nil
    end
    next_number = [current, (latest || 0) + 1].max
    increment_build_number(build_number: next_number, xcodeproj: PROJECT)
    UI.message("Building version #{version} (#{next_number}) with export method #{export_method}")

    gym(
      project: PROJECT,
      scheme: SCHEME,
      destination: "generic/platform=iOS",
      derived_data_path: File.join(ROOT, "DerivedDataArchive"),
      export_method: export_method,
      export_options: {
        method: export_method,
        signingStyle: "automatic",
        teamID: TEAM_ID
      },
      xcargs: "-skipPackagePluginValidation -allowProvisioningUpdates ONLY_ACTIVE_ARCH=NO",
      clean: false,
      output_directory: EXPORT_DIR
    )

    upload_beta
  end
end
